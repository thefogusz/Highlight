{
  "manifest_version": 3,
  "name": "Highlight \u2014 YouTube connection",
  "version": "0.3.8",
  "description": "Connect your existing YouTube session to Highlight on this computer.",
  "key": "",
  "permissions": [
    "cookies",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
